# Copy to .env.local and fill in. These keys stay on the server; the browser never sees them.

# Required: Claude API key (https://console.anthropic.com/). Used for live answers,
# CV parsing, screenshot analysis and CV / cover-letter generation.
ANTHROPIC_API_KEY=

# Optional: Deepgram key (https://console.deepgram.com/) for low-latency streaming
# transcription of the meeting tab + microphone. The key needs the "Member" role
# (or higher): the server uses it to mint 60-second tokens for the browser, so the
# key itself never leaves the server. Without it, the free browser speech
# recognition (microphone only, Chrome/Edge) is used.
DEEPGRAM_API_KEY=

# Optional: default model when the browser does not send one.
# claude-opus-5-5 (default) | claude-sonnet-5-5 | claude-haiku-5-5
# SOUFFLEUR_MODEL=claude-opus-5-5

# Optional but strongly recommended if the app is reachable by anyone else:
# HTTP Basic auth on every page and API route.
# SOUFFLEUR_USER=souffleur
# SOUFFLEUR_PASSWORD=
